{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "warikapp-dev",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "warikapp-dev-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "warikapp-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3100"],
      "port": 3100
    }
  ]
}
